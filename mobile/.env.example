# Copy to .env.local. Expo inlines EXPO_PUBLIC_* into the bundle at build time,
# so only values that may ship inside the app belong here: the same two the web
# page gets as VITE_SUPABASE_*. The Anthropic key never comes near the app.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# The deployment the app talks to. Defaults to production when unset.
# EXPO_PUBLIC_API_URL=https://delve-gm.vercel.app
