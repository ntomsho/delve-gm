{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The game's source is written with `.ts` on every import, as the web build wants.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": ["./src/*"],
      // The shared game, one folder up: src/api-client, src/rules, src/gameplay ...
      "@delve/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
