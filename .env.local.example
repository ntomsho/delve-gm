# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# Deliberately NOT prefixed with VITE_. Vite only inlines VITE_* variables into
# client code; this one is read only by the API server (src/server/app.ts) and
# the dev CLIs, so it never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-...

# The Supabase TRANSACTION POOLER connection string, port 6543 — Supabase
# dashboard → Project Settings → Database → Connection string → Transaction
# pooler. Session mode (5432) works right up until two requests overlap.
#
# Read by src/server/db/connection.ts, in Node. Never reaches the browser, same as above.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Accounts ---------------------------------------------------------------

# The Supabase project URL. Read by src/server/auth.ts to find the JWKS the
# access tokens are verified against. There is NO JWT secret to set: the project
# signs with asymmetric ES256 keys, so verification uses the public key set.
SUPABASE_URL=https://<ref>.supabase.co

# The same two values again, VITE_-prefixed so they reach the browser — and
# they MUST. This is not a hole in the rule above about ANTHROPIC_API_KEY: the
# publishable key is designed to ship inside a page, identifies the project, and
# grants nothing on its own, because every table has RLS on with owner-only
# policies. The Anthropic key is still server-only and still never inlined.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional. Extra browser origins allowed to call the API, comma-separated.
# https://delve-gm.vercel.app, https://aidungeon.vercel.app and
# http://localhost:5173 are always allowed.
# CORS_ORIGINS=https://preview-xyz.vercel.app

# --- Guests -----------------------------------------------------------------

# Optional. Cloudflare Turnstile SITE key, which turns on the bot check in front
# of "Play as a guest". Public by design, like the publishable key. Set it ONLY
# together with captcha in Supabase (Authentication → Attack Protection, with
# the Turnstile SECRET key there): one without the other either checks nothing
# or refuses every guest. See src/ui/sign-in/turnstile.ts.
# VITE_TURNSTILE_SITE_KEY=0x4AAAA...

# --- Illustrations ----------------------------------------------------------

# Optional. Without both, every room simply has no illustration.
# FAL_KEY draws the images (fal.ai); the service-role key stores them in the
# public `plates` bucket. Both are server-only, like ANTHROPIC_API_KEY.
# FAL_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
