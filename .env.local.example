# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# Deliberately NOT prefixed with VITE_. Vite only inlines VITE_* variables into
# client code; this one is read by vite.config.ts and attached to the outbound
# request by the dev proxy, so it never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-...
