{
  "name": "dungeon-crawler",
  "version": "0.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "api": "node src/server/dev.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.api.config.ts",
    "build:client": "vite build",
    "build:api": "vite build --config vite.api.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate": "node src/dev/cli-generate.ts",
    "generate:dry": "node src/dev/cli-generate.ts --dry",
    "play": "node src/dev/cli-play.ts",
    "play:offline": "node src/dev/cli-play.ts --offline",
    "test:db": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vite.db.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntomsho/aidungeon.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/ntomsho/aidungeon/issues"
  },
  "homepage": "https://github.com/ntomsho/aidungeon#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "hono": "^4.13.2",
    "jose": "^6.2.9",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-tooltip": "^6.0.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "private": true
}
