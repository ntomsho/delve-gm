node_modules/
dist/
dist-ssr/

# The API key. Never commit this.
.env.local
.env.*.local

# Headless generation output
out/
*.local

.DS_Store
*.log
npm-debug.log*

.vscode/*
!.vscode/extensions.json
.idea/

# Built by `npm run build:api` from src/server/vercel.ts. Not source —
# `api/` holds only the bundle, so Vercel has no TypeScript there to build.
#
# THE BUNDLE IS COMMITTED, AND THAT IS DELIBERATE. Vercel validates the
# `functions` glob in vercel.json against the GitHub clone BEFORE running
# buildCommand, so an ignored api/index.js means every git push fails in 130ms
# with "the pattern api/index.js doesn't match any Serverless Functions". A main
# branch that cannot deploy itself is a trap. The build regenerates it anyway;
# committing it only means the pattern has something to match.
#
# Anything ELSE that lands in api/ is still ignored, because a .ts beside the
# bundle would invite Vercel to build the source with the bundler that cannot
# read `?raw`, which is the whole reason the API is bundled by Vite.
api/*
!api/index.js

.vercel
.env*

# TypeScript incremental build cache
*.tsbuildinfo
